# =============================================================================
# BIM VisitPlan — environment template
# =============================================================================
# Copy to .env and fill in:   cp .env.example .env
#
# EXPO_PUBLIC_* values are inlined into the JavaScript bundle at build time. They
# are NOT secret at runtime — anyone with the app can read them. Keeping them out
# of source control prevents accidental exposure through git history, but never
# put a client secret or API key with real privileges here.
#
# The app uses PKCE (public OAuth client), which is precisely why no secret is
# needed: it is designed for clients that cannot keep one.
# =============================================================================


# --- Backend -----------------------------------------------------------------

# bim-crm API base URL. REQUIRED — config.ts has no fallback on purpose: the old
# uat-crm host is decommissioned, so an unset value must fail loudly rather than
# quietly address a dead server.
#
#   Local (Expo Web, simulator):  http://localhost:8000
#   Physical device on your LAN:  http://192.168.x.x:8000   (localhost is the phone)
#   Deployed:                     https://crm.example.com
EXPO_PUBLIC_CRM_API_URL=http://localhost:8000


# --- Microsoft Entra ID ------------------------------------------------------
# Azure Portal → App registrations. Create a PUBLIC client (Mobile and desktop
# applications platform). Do NOT create a secret; PKCE does not use one.
#
# Redirect URIs to register:
#   iOS / Android:  msauth.com.bim.visitplan://auth
#   Expo Web:       http://localhost:8043
#
# The scheme must match `expo.scheme` in app.json and this variable.

EXPO_PUBLIC_ENTRA_CLIENT_ID=
EXPO_PUBLIC_ENTRA_TENANT_ID=
EXPO_PUBLIC_ENTRA_REDIRECT_SCHEME=msauth.com.bim.visitplan


# --- Cockpit CMS (retired) ---------------------------------------------------
# The previous backend, being removed. src/lib/cockpit.ts still references these
# until that file is deleted at the end of the migration; blank values simply make
# those calls fail rather than reaching a live CMS. Do not set them.

EXPO_PUBLIC_COCKPIT_API_URL=
EXPO_PUBLIC_COCKPIT_API_TOKEN=


# =============================================================================
# Notes
# =============================================================================
#
# Sign-in currently uses the CRM's local dev-token bypass, because the Entra mobile
# app registration above does not exist yet. That path requires the backend to run
# with APP_ENV=local and AUTH_BYPASS_ENABLED=true, and 404s anywhere else.
#
# Once the registration exists, fill in the ENTRA_* values and real sign-in works —
# including against a backend on your LAN. It does not require the CRM to be
# deployed publicly: the app talks to Microsoft directly and only posts the
# resulting id_token to the CRM.
#
# CORS: when running Expo Web, the CRM must list this origin in
# CORS_ALLOWED_ORIGINS. Native builds do not enforce CORS.
# =============================================================================
